# ═══════════════════════════════════════════════════════════
# STAR — environment template. Copy to `.env` and edit.
# NEVER put real credentials in this file or commit `.env`.
# ═══════════════════════════════════════════════════════════

# ── Django core ──
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Comma separated; used to allow browser clients during development only.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ── Database (docker-compose service `db`) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=star
POSTGRES_USER=star
POSTGRES_PASSWORD=star_dev_password

# ── Authentication ──
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Minutes before single-use auth tokens (verify / password reset) expire.
AUTH_TOKEN_TTL_MINUTES=60
# Login attempts before an IP/user is throttled.
LOGIN_THROTTLE_RATE=10/min
# Require TOTP second factor for platform administrators (true/false).
REQUIRE_MFA_FOR_PLATFORM_ADMINS=false
# Require email verification links on registration (true in production).
REQUIRE_EMAIL_VERIFICATION=true
# Public URL of the web app (used in verification / password-reset links).
FRONTEND_URL=http://localhost:5174

# ── Email (development uses the console backend) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=star@example.invalid

# ── Media / private attachments ──
PRIVATE_MEDIA_ROOT=
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.docx
AUDIO_RETENTION_DAYS=7

# ── Voice transcription (mock provider until a real one is contracted) ──
# Provider key: `mock` is the only one implemented today.
TRANSCRIPTION_PROVIDER=mock
# Flip to true to simulate a provider outage (API answers 503).
TRANSCRIPTION_MOCK_FAILURE=false
# Comma separated BCP-47-ish codes the mock pretends to understand.
TRANSCRIPTION_LANGUAGES=en,fr
AUDIO_MAX_SIZE_MB=10
AUDIO_ALLOWED_EXTENSIONS=.wav,.ogg,.webm,.mp3,.m4a

# ── Integrations (sandbox/mock until real credentials exist) ──
PAYMENT_PROVIDER=sandbox
# HMAC key verified on payment webhooks (falls back to DJANGO_SECRET_KEY).
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# A pending order is cancelled (and its stock released) after this many hours.
PAYMENT_PENDING_TTL_HOURS=24
# Sandbox outcomes are honoured outside production only; production.py forces
# this to false so mock money can never look real.
PAYMENTS_ACCEPT_MOCK=true

# ── Reports / exports ──
# How long a generated artifact stays downloadable (hours).
REPORT_ARTIFACT_TTL_HOURS=24
# Exports larger than this many rows are rejected (sync generation limit).
REPORT_SYNC_ROW_LIMIT=50000
# purge_expired_reports exits non-zero above this expired-artifact backlog.
REPORT_RETENTION_BACKLOG_ALERT=100

# ── API / docs ──
API_PAGE_SIZE=20

# ── Production hardening (used by config.settings.production) ──
SECURE_HSTS_SECONDS=31536000
# Database connection reuse (seconds).
DB_CONN_MAX_AGE=60
# Log level: DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO
